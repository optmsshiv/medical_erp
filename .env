# Master database (client registry only)
# MASTER_DB_HOST=localhost
# MASTER_DB_NAME=edrppymy_optms_pharma
# MASTER_DB_USER=edrppymy_optms_pharma
# MASTER_DB_PASS=1357@Pharma

MASTER_DB_HOST=127.0.0.1
MASTER_DB_NAME=medical_master
MASTER_DB_USER=root
MASTER_DB_PASS=

LOCAL_DEV_SUBDOMAIN=local

# Prefix applied to every client db/user name — set this to your
# cPanel account username on shared hosting (the part before the
# underscore in the database name above, e.g. "edrppymy")
DB_PREFIX=edrppymy

# For local development without real subdomains, set which client
# to simulate (Tenant.php falls back to this when host has < 3 parts)
# need to change for live
# LOCAL_DEV_SUBDOMAIN=

# Needed for cPanel database provisioning (core/CpanelApi.php)
# Generate a token: cPanel > Security > Manage API Tokens
CPANEL_HOST=rx.optms.co.in:2083
CPANEL_USER=edrppymy
CPANEL_TOKEN=CQW7ZIDI1758MVAT0FEIDXL5WE5SRNVD

# The domain clients are reached on — each client gets {subdomain}.APP_DOMAIN
APP_DOMAIN=optms.co.in

# Stopgap access key for /super-admin — replace with real auth+roles later.
# Generate something long/random, e.g.: php -r "echo bin2hex(random_bytes(24));"
SUPER_ADMIN_KEY=13579